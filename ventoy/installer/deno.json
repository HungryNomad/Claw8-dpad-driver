{
  "tasks": {
    "install": "deno run --allow-read --allow-write --allow-run main.ts install",
    "uninstall": "deno run --allow-read --allow-write --allow-run main.ts uninstall",
    "status": "deno run --allow-read --allow-write --allow-run main.ts status",
    "package": "deno run --allow-read --allow-write --allow-run --allow-env=SOURCE_DATE_EPOCH package.ts",
    "smoke": "deno run --allow-read --allow-write --allow-run smoke.ts",
    "test": "deno test --allow-read --allow-write --allow-run --allow-env=SOURCE_DATE_EPOCH"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/cli": "jsr:@std/cli@^1",
    "@std/path": "jsr:@std/path@^1"
  },
  "fmt": { "lineWidth": 100 }
}
